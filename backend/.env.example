# Server
NODE_ENV=development
PORT=5000
WORKER_MODE=all

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite file, no server required)
DATABASE_PATH=./data/outbox.db

# Redis (required for BullMQ queue). Start with: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Email transport
# Set ETHEREAL=true to auto-create a free Ethereal test inbox (recommended for demo).
# Set ETHEREAL=false and provide SMTP_* values to use a real/relay SMTP server.
# If both Ethereal and SMTP are unavailable, the app falls back to a JSON transport
# that logs the message instead of sending (still marks emails as sent).
ETHEREAL=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Email Scheduler <no-reply@example.com>

# Queue / concurrency / rate limiting
QUEUE_CONCURRENCY=2
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_MS=1000
USER_EMAIL_RATE_LIMIT=50